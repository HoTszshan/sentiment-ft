for line in open(main):
  mc[(json.loads(line).get('meta') or {}).get('sentiment')]+=1
mn=sum(mc.values())
rescued=c['negative']
print(f"合并后: {mn+n} 条  negative: {mc['negative']}+{rescued}={mc['negative']+rescued} ({(mc['negative']+rescued)/(mn+n)*100:.1f}%)  目标 ≥30%")
